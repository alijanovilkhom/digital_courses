# Server-only. Copy to .env.local and fill in. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: override the models (defaults are set in src/lib/rag/gemini.ts).
# The embedding model must act like gemini-embedding-001: one vector per text, supports taskType.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Google Drive (optional). Create an OAuth client of type "Desktop app" in Google Cloud, enable the Drive API,
# then run `npm run drive-auth` once: it writes GOOGLE_REFRESH_TOKEN here.
# GOOGLE_DRIVE_FOLDER_ID is the last part of the folder's URL in Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
