{
  "name": "digital-courses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "drive-auth": "tsx --env-file-if-exists=.env.local scripts/drive-auth.ts",
    "drive-sync": "tsx --env-file-if-exists=.env.local scripts/drive-sync.ts",
    "sync": "npm run drive-sync && npm run ingest",
    "vercel-build": "npm run sync && next build"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
